@prefix : <http://example.org/fire-ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Parent Classes
:FireIgnitionSensor rdf:type rdfs:Class ;
    rdfs:label "Fire Ignition Sensor" ;
    rdfs:comment "Represents a sensor used for detecting fire ignition points" .

:PlotMetrics rdf:type rdfs:Class ;
    rdfs:label "Plot Metrics" ;
    rdfs:comment "Represents data about a specific plot of land related to fire risk and behavior" .

:FireManagementArea rdf:type rdfs:Class ;
    rdfs:label "Fire Management Area" ;
    rdfs:comment "Represents the geographical area where fire management activities are carried out" .

# Subclasses of FireIgnitionSensor
:SensorMetadata rdf:type rdfs:Class ;
    rdfs:subClassOf :FireIgnitionSensor ;
    rdfs:label "Sensor Metadata" ;
    rdfs:comment "Metadata related to the FireIgnitionSensor" .

:LocationData rdf:type rdfs:Class ;
    rdfs:subClassOf :FireIgnitionSensor ;
    rdfs:label "Location Data" ;
    rdfs:comment "Represents the geographical location of the FireIgnitionSensor" .

:SensorTypeData rdf:type rdfs:Class ;
    rdfs:subClassOf :FireIgnitionSensor ;
    rdfs:label "Sensor Type Data" ;
    rdfs:comment "Represents data related to the type of fire sensor" .

:EnvironmentalData rdf:type rdfs:Class ;
    rdfs:subClassOf :FireIgnitionSensor ;
    rdfs:label "Environmental Data" ;
    rdfs:comment "Represents environmental data collected by the sensor" .

:ParticleData rdf:type rdfs:Class ;
    rdfs:subClassOf :FireIgnitionSensor ;
    rdfs:label "Particle Data" ;
    rdfs:comment "Represents particle data, such as particle density and size" .

:WindData rdf:type rdfs:Class ;
    rdfs:subClassOf :FireIgnitionSensor ;
    rdfs:label "Wind Data" ;
    rdfs:comment "Represents wind speed and direction data collected by the sensor" .

# Subclasses of PlotMetrics
:VegetationMetrics rdf:type rdfs:Class ;
    rdfs:subClassOf :PlotMetrics ;
    rdfs:label "Vegetation Metrics" ;
    rdfs:comment "Represents vegetation data collected from a plot" .

:FireBehaviorMetrics rdf:type rdfs:Class ;
    rdfs:subClassOf :PlotMetrics ;
    rdfs:label "Fire Behavior Metrics" ;
    rdfs:comment "Captures the behavior of fire including intensity, spread, and firefront data" .

:TreeShrubMetrics rdf:type rdfs:Class ;
    rdfs:subClassOf :PlotMetrics ;
    rdfs:label "Tree Shrub Metrics" ;
    rdfs:comment "Captures metrics related to trees and shrubs in a plot" .

:LocationDataPlot rdf:type rdfs:Class ;
    rdfs:subClassOf :PlotMetrics ;
    rdfs:label "Location Data Plot" ;
    rdfs:comment "Represents location data related to a plot's geographic coordinates" .

# Properties for FireIgnitionSensor
:db_id rdf:type rdf:Property ;
    rdfs:domain :SensorMetadata ;
    rdfs:range xsd:int ;
    rdfs:label "db_id" ;
    rdfs:comment "Unique identifier for the sensor in the database" .

:model_type rdf:type rdf:Property ;
    rdfs:domain :SensorMetadata ;
    rdfs:range xsd:string ;
    rdfs:label "model_type" ;
    rdfs:comment "Type/model of the sensor" .

:time rdf:type rdf:Property ;
    rdfs:domain :SensorMetadata ;
    rdfs:range xsd:dateTime ;
    rdfs:label "time" ;
    rdfs:comment "Timestamp for the sensor data" .

:db_urn rdf:type rdf:Property ;
    rdfs:domain :SensorMetadata ;
    rdfs:range xsd:string ;
    rdfs:label "db_urn" ;
    rdfs:comment "Universal resource name for the sensor data" .

:device_alias rdf:type rdf:Property ;
    rdfs:domain :SensorMetadata ;
    rdfs:range xsd:string ;
    rdfs:label "device_alias" ;
    rdfs:comment "Alias for the sensor device" .

:sensor_type_id rdf:type rdf:Property ;
    rdfs:domain :SensorMetadata ;
    rdfs:range xsd:int ;
    rdfs:label "sensor_type_id" ;
    rdfs:comment "ID for the sensor type" .

:longitude rdf:type rdf:Property ;
    rdfs:domain :LocationData ;
    rdfs:range xsd:float ;
    rdfs:label "longitude" ;
    rdfs:comment "Longitude coordinate of the sensor" .

:latitude rdf:type rdf:Property ;
    rdfs:domain :LocationData ;
    rdfs:range xsd:float ;
    rdfs:label "latitude" ;
    rdfs:comment "Latitude coordinate of the sensor" .

:type rdf:type rdf:Property ;
    rdfs:domain :SensorTypeData ;
    rdfs:range xsd:string ;
    rdfs:label "type" ;
    rdfs:comment "Type of sensor (e.g., heat, smoke)" .

:temperatureMillidegreeC rdf:type rdf:Property ;
    rdfs:domain :EnvironmentalData ;
    rdfs:range xsd:int ;
    rdfs:label "temperatureMillidegreeC" ;
    rdfs:comment "Temperature in millidegrees Celsius" .

:barometricPa rdf:type rdf:Property ;
    rdfs:domain :EnvironmentalData ;
    rdfs:range xsd:int ;
    rdfs:label "barometricPa" ;
    rdfs:comment "Barometric pressure in Pascals" .

:humidityRh rdf:type rdf:Property ;
    rdfs:domain :EnvironmentalData ;
    rdfs:range xsd:int ;
    rdfs:label "humidityRh" ;
    rdfs:comment "Humidity as relative humidity percentage" .

:CO2Ppm rdf:type rdf:Property ;
    rdfs:domain :EnvironmentalData ;
    rdfs:range xsd:int ;
    rdfs:label "CO2Ppm" ;
    rdfs:comment "Concentration of CO2 in parts per million" .

:mos_gasResistance rdf:type rdf:Property ;
    rdfs:domain :EnvironmentalData ;
    rdfs:range xsd:int ;
    rdfs:label "mos_gasResistance" ;
    rdfs:comment "Gas resistance measured by MOS sensor" .

:pmsensor_pm10Standard rdf:type rdf:Property ;
    rdfs:domain :ParticleData ;
    rdfs:range xsd:int ;
    rdfs:label "pmsensor_pm10Standard" ;
    rdfs:comment "PM10 particle density" .

:pmsensor_pm25Standard rdf:type rdf:Property ;
    rdfs:domain :ParticleData ;
    rdfs:range xsd:int ;
    rdfs:label "pmsensor_pm25Standard" ;
    rdfs:comment "PM2.5 particle density" .

:wind_windDirectionDegrees rdf:type rdf:Property ;
    rdfs:domain :WindData ;
    rdfs:range xsd:int ;
    rdfs:label "wind_windDirectionDegrees" ;
    rdfs:comment "Wind direction in degrees" .

:wind_windSpeedCmS rdf:type rdf:Property ;
    rdfs:domain :WindData ;
    rdfs:range xsd:int ;
    rdfs:label "wind_windSpeedCmS" ;
    rdfs:comment "Wind speed in cm/s" .

# Properties for PlotMetrics
:basalArea rdf:type rdf:Property ;
    rdfs:domain :VegetationMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "basalArea" ;
    rdfs:comment "Basal area of the vegetation" .

:LAI rdf:type rdf:Property ;
    rdfs:domain :VegetationMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "LAI" ;
    rdfs:comment "Leaf Area Index" .

:TBA rdf:type rdf:Property ;
    rdfs:domain :VegetationMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "TBA" ;
    rdfs:comment "Total Basal Area" .

:plotName rdf:type rdf:Property ;
    rdfs:domain :TreeShrubMetrics ;
    rdfs:range xsd:string ;
    rdfs:label "plotName" ;
    rdfs:comment "The name of the plot" .

# Properties for FireManagementArea
:geometry rdf:type rdf:Property ;
    rdfs:domain :FireManagementArea ;
    rdfs:range xsd:string ;
    rdfs:label "geometry" ;
    rdfs:comment "Geospatial representation of the FireManagementArea in GeoJSON or WKT format" .

:hasPlot rdf:type rdf:Property ;
    rdfs:domain :FireManagementArea ;
    rdfs:range :PlotMetrics ;
    rdfs:label "hasPlot" ;
    rdfs:comment "Indicates the plots that intersect the FireManagementArea" .

:hasFireIgnitionSensor rdf:type rdf:Property ;
    rdfs:domain :FireManagementArea ;
    rdfs:range :FireIgnitionSensor ;
    rdfs:label "hasFireIgnitionSensor" ;
    rdfs:comment "Indicates the sensors that intersect the FireManagementArea" .

# Properties for PlotMetrics: VegetationMetrics
:GCvol rdf:type rdf:Property ;
    rdfs:domain :VegetationMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "GCvol" ;
    rdfs:comment "Gross volume of vegetation" .

:MSvol rdf:type rdf:Property ;
    rdfs:domain :VegetationMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "MSvol" ;
    rdfs:comment "Merchantable solid volume of vegetation" .

:OSvol rdf:type rdf:Property ;
    rdfs:domain :VegetationMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "OSvol" ;
    rdfs:comment "Other solid volume of vegetation" .

:USvol rdf:type rdf:Property ;
    rdfs:domain :VegetationMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "USvol" ;
    rdfs:comment "Understory solid volume of vegetation" .

# Properties for PlotMetrics: FireBehaviorMetrics
:LF_FBFM13 rdf:type rdf:Property ;
    rdfs:domain :FireBehaviorMetrics ;
    rdfs:range xsd:string ;
    rdfs:label "LF_FBFM13" ;
    rdfs:comment "Fire behavior fuel model 13" .

:LF_FBFM40 rdf:type rdf:Property ;
    rdfs:domain :FireBehaviorMetrics ;
    rdfs:range xsd:string ;
    rdfs:label "LF_FBFM40" ;
    rdfs:comment "Fire behavior fuel model 40" .

:LF_EVEL rdf:type rdf:Property ;
    rdfs:domain :FireBehaviorMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "LF_EVEL" ;
    rdfs:comment "Elevation of the site in meters" .

:LF_SLPD rdf:type rdf:Property ;
    rdfs:domain :FireBehaviorMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "LF_SLPD" ;
    rdfs:comment "Slope percentage of the site" .

:LF_ASP rdf:type rdf:Property ;
    rdfs:domain :FireBehaviorMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "LF_ASP" ;
    rdfs:comment "Aspect of the site in degrees" .

:LF_FDist rdf:type rdf:Property ;
    rdfs:domain :FireBehaviorMetrics ;
    rdfs:range xsd:string ;
    rdfs:label "LF_FDist" ;
    rdfs:comment "Distance from the fire front" .

:LF_EVC rdf:type rdf:Property ;
    rdfs:domain :FireBehaviorMetrics ;
    rdfs:range xsd:string ;
    rdfs:label "LF_EVC" ;
    rdfs:comment "Expected vegetation cover at the site" .

:LF_EVT rdf:type rdf:Property ;
    rdfs:domain :FireBehaviorMetrics ;
    rdfs:range xsd:string ;
    rdfs:label "LF_EVT" ;
    rdfs:comment "Expected vegetation type at the site" .

:LF_DISTP rdf:type rdf:Property ;
    rdfs:domain :FireBehaviorMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "LF_DISTP" ;
    rdfs:comment "Distance to the nearest plot" .

# Properties for PlotMetrics: TreeShrubMetrics
:MDBH rdf:type rdf:Property ;
    rdfs:domain :TreeShrubMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "MDBH" ;
    rdfs:comment "Mean diameter at breast height for trees" .

:MLAI rdf:type rdf:Property ;
    rdfs:domain :TreeShrubMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "MLAI" ;
    rdfs:comment "Mean leaf area index for the plot" .

:SDHT rdf:type rdf:Property ;
    rdfs:domain :TreeShrubMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "SDHT" ;
    rdfs:comment "Shrub height in the plot" .

:SDSHT rdf:type rdf:Property ;
    rdfs:domain :TreeShrubMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "SDSHT" ;
    rdfs:comment "Standard deviation of shrub height" .

:SDSD rdf:type rdf:Property ;
    rdfs:domain :TreeShrubMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "SDSD" ;
    rdfs:comment "Standard deviation of shrub diameter" .

:MaxSD rdf:type rdf:Property ;
    rdfs:domain :TreeShrubMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "MaxSD" ;
    rdfs:comment "Maximum shrub diameter in the plot" .

:MaxSH rdf:type rdf:Property ;
    rdfs:domain :TreeShrubMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "MaxSH" ;
    rdfs:comment "Maximum shrub height in the plot" .

:MaxTH rdf:type rdf:Property ;
    rdfs:domain :TreeShrubMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "MaxTH" ;
    rdfs:comment "Maximum tree height in the plot" .

:MinSD rdf:type rdf:Property ;
    rdfs:domain :TreeShrubMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "MinSD" ;
    rdfs:comment "Minimum shrub diameter in the plot" .

:TreesN rdf:type rdf:Property ;
    rdfs:domain :TreeShrubMetrics ;
    rdfs:range xsd:int ;
    rdfs:label "TreesN" ;
    rdfs:comment "Number of trees in the plot" .

:ShrubsN rdf:type rdf:Property ;
    rdfs:domain :TreeShrubMetrics ;
    rdfs:range xsd:int ;
    rdfs:label "ShrubsN" ;
    rdfs:comment "Number of shrubs in the plot" .

:MeanSA rdf:type rdf:Property ;
    rdfs:domain :TreeShrubMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "MeanSA" ;
    rdfs:comment "Mean shrub area in square meters" .

:shrubArea rdf:type rdf:Property ;
    rdfs:domain :TreeShrubMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "shrubArea" ;
    rdfs:comment "Total shrub area in square meters" .

:scaledShrubArea rdf:type rdf:Property ;
    rdfs:domain :TreeShrubMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "scaledShrubArea" ;
    rdfs:comment "Scaled shrub area" .

:CBH rdf:type rdf:Property ;
    rdfs:domain :TreeShrubMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "CBH" ;
    rdfs:comment "Canopy base height" .

:MeanSH rdf:type rdf:Property ;
    rdfs:domain :TreeShrubMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "MeanSH" ;
    rdfs:comment "Mean shrub height" .

:MeanTH rdf:type rdf:Property ;
    rdfs:domain :TreeShrubMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "MeanTH" ;
    rdfs:comment "Mean tree height" .

:LF_CBD rdf:type rdf:Property ;
    rdfs:domain :TreeShrubMetrics ;
    rdfs:range xsd:float ;
    rdfs:label "LF_CBD" ;
    rdfs:comment "Canopy bulk density" .

# Properties for FireManagementArea
# These properties define the relationships and the geographical information

:hasPlot rdf:type rdf:Property ;
    rdfs:domain :FireManagementArea ;
    rdfs:range :PlotMetrics ;
    rdfs:label "hasPlot" ;
    rdfs:comment "Indicates the plots that intersect the FireManagementArea" .

:hasFireIgnitionSensor rdf:type rdf:Property ;
    rdfs:domain :FireManagementArea ;
    rdfs:range :FireIgnitionSensor ;
    rdfs:label "hasFireIgnitionSensor" ;
    rdfs:comment "Indicates the sensors that intersect the FireManagementArea" .

# Geospatial property for PlotMetrics
:geometry rdf:type rdf:Property ;
    rdfs:domain :FireManagementArea ;
    rdfs:range xsd:string ;
    rdfs:label "geometry" ;
    rdfs:comment "Geospatial representation of the FireManagementArea in GeoJSON or WKT format" .
